{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.crececonads.site"
        }
      ],
      "destination": "https://crececonads.site/:path*",
      "permanent": true
    },
    {
      "source": "/portfolio-automatizaciones-k7q2",
      "destination": "/portfolio-damian-presmanes",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/propuestas/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/crm",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/suscribir.js": {
      "maxDuration": 10
    },
    "api/lead.js": {
      "maxDuration": 10
    },
    "api/crm.js": {
      "maxDuration": 30
    }
  }
}
